<Project>

  <!--
    Configuracion de FamilyLink: proyecto de Supabase, clientes OAuth para vincular la cuenta y
    Firebase (solo Messaging).

    Los valores reales NO viven en el repositorio (constitucion y push protection de GitHub): se
    leen de familylink.local.props (ignorado por git) o de variables de entorno, y de ahi se genera
    en obj/ la clase FamilyLinkConfig con constantes. Es el mismo mecanismo que oauth.props de
    Task Manager.

    Sin valores el fichero se genera igual, con cadenas vacias: la compilacion no se rompe,
    FamilyLinkConfig.IsServerConfigured vale false y la app lo cuenta en vez de fallar.
  -->
  <Import Project="$(MSBuildThisFileDirectory)familylink.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)familylink.local.props')" />

  <PropertyGroup>
    <FlSupabaseUrl Condition="'$(FlSupabaseUrl)' == ''">$(FL_SUPABASE_URL)</FlSupabaseUrl>
    <FlPublishableKey Condition="'$(FlPublishableKey)' == ''">$(FL_PUBLISHABLE_KEY)</FlPublishableKey>
    <FlGoogleClientId Condition="'$(FlGoogleClientId)' == ''">$(FL_GOOGLE_CLIENT_ID)</FlGoogleClientId>
    <FlGoogleClientSecret Condition="'$(FlGoogleClientSecret)' == ''">$(FL_GOOGLE_CLIENT_SECRET)</FlGoogleClientSecret>
    <FlMicrosoftClientId Condition="'$(FlMicrosoftClientId)' == ''">$(FL_MS_CLIENT_ID)</FlMicrosoftClientId>
    <FlFcmProjectId Condition="'$(FlFcmProjectId)' == ''">$(FL_FCM_PROJECT_ID)</FlFcmProjectId>
    <FlFcmApplicationId Condition="'$(FlFcmApplicationId)' == ''">$(FL_FCM_APP_ID)</FlFcmApplicationId>
    <FlFcmApiKey Condition="'$(FlFcmApiKey)' == ''">$(FL_FCM_API_KEY)</FlFcmApiKey>
    <FlFcmSenderId Condition="'$(FlFcmSenderId)' == ''">$(FL_FCM_SENDER_ID)</FlFcmSenderId>

    <!--
      Esquema de vuelta de Google: el identificador de cliente invertido
      (com.googleusercontent.apps.<id>). Google no admite un esquema cualquiera (Error 400:
      invalid_request) y el intent-filter de Android necesita el valor en una constante de
      compilacion, asi que se calcula aqui y viaja como una constante mas. Sin cliente, vacio.
      Por que el de escritorio y no uno de tipo Android: ver IdentitySignInService.
    -->
    <FlGoogleRedirectScheme Condition="'$(FlGoogleClientId)' != ''">com.googleusercontent.apps.$(FlGoogleClientId.Replace('.apps.googleusercontent.com', ''))</FlGoogleRedirectScheme>
  </PropertyGroup>

  <!--
    El fichero se rehace SIEMPRE, sin Inputs/Outputs: los valores de verdad no estan en este
    fichero sino en familylink.local.props o en el entorno, y con Inputs apuntando aqui MSBuild se
    saltaba la generacion al cambiar un identificador (le costo una tarde a Task Manager el
    2026-09-04). WriteOnlyWhenDifferent mantiene la compilacion incremental.
  -->
  <Target Name="GenerateFamilyLinkConfig" BeforeTargets="BeforeCompile;CoreCompile">
    <ItemGroup>
      <FlConfigLine Include="// Generado por familylink.props. No editar ni subir al repositorio." />
      <FlConfigLine Include="namespace FamilyLink.Core%3B" />
      <FlConfigLine Include="public static partial class FamilyLinkConfig" />
      <FlConfigLine Include="{" />
      <FlConfigLine Include="    public const string SupabaseUrl = &quot;$(FlSupabaseUrl)&quot;%3B" />
      <FlConfigLine Include="    public const string PublishableKey = &quot;$(FlPublishableKey)&quot;%3B" />
      <FlConfigLine Include="    public const string GoogleClientId = &quot;$(FlGoogleClientId)&quot;%3B" />
      <FlConfigLine Include="    public const string GoogleClientSecret = &quot;$(FlGoogleClientSecret)&quot;%3B" />
      <FlConfigLine Include="    public const string GoogleRedirectScheme = &quot;$(FlGoogleRedirectScheme)&quot;%3B" />
      <FlConfigLine Include="    public const string MicrosoftClientId = &quot;$(FlMicrosoftClientId)&quot;%3B" />
      <FlConfigLine Include="    public const string FcmProjectId = &quot;$(FlFcmProjectId)&quot;%3B" />
      <FlConfigLine Include="    public const string FcmApplicationId = &quot;$(FlFcmApplicationId)&quot;%3B" />
      <FlConfigLine Include="    public const string FcmApiKey = &quot;$(FlFcmApiKey)&quot;%3B" />
      <FlConfigLine Include="    public const string FcmSenderId = &quot;$(FlFcmSenderId)&quot;%3B" />
      <FlConfigLine Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)FamilyLinkConfig.g.cs" Lines="@(FlConfigLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="IncludeFamilyLinkConfig" DependsOnTargets="GenerateFamilyLinkConfig" BeforeTargets="BeforeCompile;CoreCompile">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)FamilyLinkConfig.g.cs" />
    </ItemGroup>
  </Target>

</Project>
