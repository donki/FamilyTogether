<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FamilyTogether.Core</RootNamespace>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Socratic</Authors>
    <Company>Socratic</Company>
    <Description>Nucleo de Family Together: cliente de Supabase, cifrado de grupo, cola local de posiciones, SOS, zonas y avisos.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      sqlite-net-pcl (MIT) + bundle_green (Apache-2.0): cola local de posiciones y SOS, estado de
      zonas y eventos ya vistos. Mismas versiones que Task Manager, y por lo mismo: bundle_green no
      pasa de 2.1.11 y mezclar nativos mas nuevos revienta en Android. El aviso NU1903 de SQLite se
      deja a la vista, sin silenciar, hasta que salga un bundle nuevo.
      QRCoder (MIT): el PNG del QR de la invitacion.
    -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FamilyTogether.Core.Tests" />
  </ItemGroup>

  <!-- Supabase, OAuth y Firebase: se generan al compilar, nunca viven en el repositorio. -->
  <Import Project="$(MSBuildThisFileDirectory)..\familytogether.props" />

</Project>
