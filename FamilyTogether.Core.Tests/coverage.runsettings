<?xml version="1.0" encoding="utf-8"?>
<!--
  Cobertura (coverlet): el nucleo y la app MAUI compilada para net10.0 (App\FamilyTogether.App.csproj).
  El codigo de las propias pruebas se excluye por ruta. CompilerGeneratedAttribute NO se excluye: los
  metodos async y las lambdas cuentan (tools\cobertura-app.py).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <ExcludeByFile>**/FamilyTogether.Core.Tests/**/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
